{
  "name": "casselin-ads",
  "version": "1.0.0",
  "description": "Casselin industrial-premium video ad (professional kitchen equipment) built with Remotion — 9:16 and 16:9 masters from one timeline.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render AdVideo out/casselin-ad-9x16.mp4",
    "render:wide": "remotion render AdVideoWide out/casselin-ad-16x9.mp4",
    "render:hd": "remotion render AdVideo out/casselin-ad-9x16.mp4 --crf=16 --image-format=png",
    "render:all": "npm run render && npm run render:wide",
    "still": "remotion still AdVideo out/poster.png --frame=40",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@remotion/fonts": "^4.0.290",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.290",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.5.4"
  }
}
